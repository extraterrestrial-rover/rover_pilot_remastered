Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Expanded: ~
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Plane Cell Count: 60
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
      Alpha: 0.4
    - Class: rviz_default_plugins/Map
      Name: Map (RTAB-Map)
      Enabled: true
      Value: true
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Value: true
      Alpha: 0.4
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Value: true
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Value: true
      Color: 25; 255; 0
      Line Style: Lines
      Line Width: 0.05
      Topic:
        Value: /plan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Local plan
      Enabled: true
      Value: true
      Color: 0; 160; 255
      Line Style: Lines
      Line Width: 0.03
      Topic:
        Value: /local_plan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Value: true
      Color: 255; 200; 0
      Alpha: 1
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/RobotModel
      Name: Rover
      Enabled: true
      Value: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.5
    - Class: rviz_default_plugins/PointCloud2
      Name: ZED point cloud (heavy over the radio)
      Enabled: false
      Value: false
      Style: Points
      Size (Pixels): 2
      Color Transformer: RGB8
      Decay Time: 0
      Topic:
        Value: /zed/zed_node/point_cloud/cloud_registered
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 40
      Target Frame: <Fixed Frame>
      X: 0
      Y: 0
      Near Clip Distance: 0.01
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: true
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
